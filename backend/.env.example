# ===========================================================================
# CareerPilot AI - Environment Configuration
# ===========================================================================

# Groq API Key (Sign up for free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Default: Llama-3.3-70B-Versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Search API Key (Get free key at https://tavily.com for live web searches)
TAVILY_API_KEY=your_tavily_api_key_here

# SQLite Database File Path (will be created automatically)
DATABASE_PATH=career_guidance.db

# Offline Fallback Mode: set to "true" to force simulation without API keys
# Set to "false" to use live Groq + Tavily APIs
OFFLINE_MODE=false

# JWT Secret Key for authenticating student sessions (HS256)
JWT_SECRET=change_me_to_a_random_secret
